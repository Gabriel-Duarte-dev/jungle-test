# Mock layer is enabled by configuration. The whole app runs against MSW.
VITE_ENABLE_MOCKS=true

# Base URL used by the Axios client. Intercepted by MSW handlers.
VITE_API_URL=https://api.kurio.test

# Socket.IO endpoint. Intercepted by the MSW WebSocket link.
VITE_SOCKET_URL=ws://api.kurio.test

# Default deterministic mock scenario on a cold start.
VITE_DEFAULT_SCENARIO=default
