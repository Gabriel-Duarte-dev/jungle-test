# Copy to `.env` for a clean checkout. The committed `.env` already holds these values,
# so the project runs with mocks enabled out of the box.

# Enables the MSW network layer. When false the app has no backend and every request fails.
VITE_ENABLE_MOCKS=true

# Base URL for the Axios client (intercepted by MSW REST handlers).
VITE_API_URL=https://api.kurio.test

# Socket.IO endpoint (intercepted by the MSW WebSocket link).
VITE_SOCKET_URL=ws://api.kurio.test

# Deterministic scenario applied on a cold start. See README for the full list.
VITE_DEFAULT_SCENARIO=default
